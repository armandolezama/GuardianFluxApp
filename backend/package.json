{
  "name": "guardianflux-backend",
  "version": "0.1.0",
  "description": "GuardianFlux – backend bancario de portafolio con arquitectura hexagonal, DDD y TDD.",
  "private": true,
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -w -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "reset:db": "ts-node src/scripts/reset-database.ts",
    "seed:invitations": "ts-node src/scripts/seed-invitations.ts"
  },
  "keywords": [
    "guardianflux",
    "banking",
    "ddd",
    "hexagonal-architecture",
    "nest",
    "node",
    "typescript"
  ],
  "author": "Armando Lezama",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/passport-jwt": "^4.0.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.9",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.9",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.9",
    "bcrypt": "^6.0.0",
    "mongoose": "^8.20.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
